# Postgres (local: docker compose up -d db)
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic
# Non-pooled URL used for migrations (same as DATABASE_URL locally; Neon "direct" URL in prod)
DIRECT_DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic

PORT=4000
# Comma-separated list of allowed frontend origins
WEB_ORIGIN=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Pusher Channels (https://dashboard.pusher.com) - realtime messaging + call signalling
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Cloudflare RealtimeKit (https://dash.cloudflare.com/?to=/:account/realtime/kit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
RTK_APP_ID=
# Presets: video presets exist by default; create two presets with meeting type "Voice" for audio calls
RTK_PRESET_VIDEO_HOST=group_call_host
RTK_PRESET_VIDEO_PARTICIPANT=group_call_participant
RTK_PRESET_AUDIO_HOST=voice_call_host
RTK_PRESET_AUDIO_PARTICIPANT=voice_call_participant
